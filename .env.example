# ─────────────────────────────────────────────
#  ROUTING CORE – Environment Variables
# ─────────────────────────────────────────────

# OpenAI
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o-mini          # or gpt-4o for higher accuracy

# Server
PORT=3000
WEBHOOK_SECRET=your-secret-token  # optional: secures your webhook endpoint

# ─── Slack Incoming Webhook URLs (one per channel) ───────────────────────────
# Create at: https://api.slack.com/apps → Your App → Incoming Webhooks
SLACK_WEBHOOK_BILLING=https://hooks.slack.com/services/YOUR/BILLING/WEBHOOK
SLACK_WEBHOOK_TECHNICAL=https://hooks.slack.com/services/YOUR/TECHNICAL/WEBHOOK
SLACK_WEBHOOK_BUG=https://hooks.slack.com/services/YOUR/BUG/WEBHOOK
SLACK_WEBHOOK_GENERAL=https://hooks.slack.com/services/YOUR/GENERAL/WEBHOOK

# Fallback channel (used when category doesn't match)
SLACK_WEBHOOK_DEFAULT=https://hooks.slack.com/services/YOUR/DEFAULT/WEBHOOK

# ─── (Optional) Slack User IDs to mention for urgent tickets ─────────────────
# Find with: /whois @username inside Slack
SLACK_ONCALL_USER_ID=U0123456789

# ─── Google Sheets (Ticket Storage – Step 2) ─────────────────────────────────
# Create a Service Account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable the Google Sheets API, download the JSON key, then fill in below.
# Share your Google Sheet with the service account email (Editor access).
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=1BxiMxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SHEET_NAME=Tickets          # name of the tab in the sheet (default: Tickets)

# ─── SMTP Email (Acknowledgment Emails – Step 2) ─────────────────────────────
# Works with Gmail (App Password), SendGrid, Mailgun, or any SMTP relay.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@yourcompany.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Support Team
EMAIL_FROM_ADDRESS=support@yourcompany.com
